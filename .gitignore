storage/client-files/
crawl/
*.png
*.jpg
*.jpeg
*.webp
*.pdf
!docs/**/*.pdf

# ---- Dependency / local builds ----
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# ---- Backups ----
backups/
*.sql.gz
*.dump

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

