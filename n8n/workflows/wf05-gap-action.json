{
  "name": "WF-05 Gap Analysis & GEO Action Planning",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wf05-gap-action",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "wf05-trigger",
      "name": "Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "wf05-gap-action"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.code AS client_code, j.id AS job_id, j.client_id, j.payload_json\nFROM claim_next_job('wf05', 900, 'GAP_ANALYSIS') j\nLEFT JOIN clients c ON c.id = j.client_id",
        "options": {}
      },
      "id": "wf05-claim",
      "name": "Claim due gap-analysis job",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [220, 0],
      "credentials": {
        "postgres": {
          "id": "QfC91xNjDOUTMtPB",
          "name": "geo-operator-postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// WF-05 entry. First analysis pass runs over ALL ACTIVE clients; later passes\n// are targeted by the job payload { client_code }. Graceful stop when no job.\nconst j = $json;\nif (!j.job_id) return { json: { skipped: true } };\nconst payload = (typeof j.payload_json === 'string' ? JSON.parse(j.payload_json) : j.payload_json) || {};\nreturn {\n  json: { hasJob: true, jobId: j.job_id, clientCode: payload.client_code || j.client_code }\n};\n"
      },
      "id": "wf05-entry",
      "name": "Resolve scope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT '{{ $('Resolve scope').item.json.clientCode }}' AS client_code, analyze_gaps('{{ $('Resolve scope').item.json.clientCode }}') AS gaps_created",
        "options": {}
      },
      "id": "wf05-analyze",
      "name": "Analyze gaps",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [660, 0],
      "credentials": {
        "postgres": {
          "id": "QfC91xNjDOUTMtPB",
          "name": "geo-operator-postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT '{{ $('Resolve scope').item.json.clientCode }}' AS client_code, plan_actions('{{ $('Resolve scope').item.json.clientCode }}') AS planned",
        "options": {}
      },
      "id": "wf05-plan",
      "name": "Plan GEO actions",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
