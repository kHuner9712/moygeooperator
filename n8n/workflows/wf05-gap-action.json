    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT '{{ $('Resolve scope').item.json.clientCode }}' AS client_code, enqueue_content_factory_jobs('{{ $('Resolve scope').item.json.clientCode }}') AS jobs_enqueued",
        "options": {}
      },
      "id": "wf05-enqueue-content",
      "name": "Enqueue content jobs (WF-06)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
