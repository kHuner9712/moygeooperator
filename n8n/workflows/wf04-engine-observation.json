    {
      "parameters": {
        "jsCode": "// P0.7 — a job may only be finished when an observation was actually persisted.\n// record_observation() returns NULL when it fails closed (e.g. no enabled\n// adapter). Never finish a job with no observation.\nconst oid = $json.observation_id || null;\nreturn { json: { hasObservation: !!oid, observationId: oid } };\n"
      },
      "id": "wf04-check-obs",
      "name": "Check observation recorded",
      "type": "n8n-nodes-base.code",
