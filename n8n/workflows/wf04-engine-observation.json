        }
      }
    },
    {
      "parameters": {
        "jsCode": "// P0.6 — route by the REAL enabled adapter (never by payload.mode).\n// adapter comes from resolve_engine_adapter(). NULL => no enabled adapter =>\n// UNSUPPORTED (fail closed, never silently Ollama).\n// P0.18 — TEST_HTTP_FAIL: deterministic fault-injection adapter (E2E only).\n// It routes to a test HTTP node that always returns 500, so the execution\n// errors and the WF-99 error handler fails the job for real.\nconst job = $node['Select observer'].json;\nconst adapter = $json.adapter || null;\nlet branch = 'unsupported';\nif (adapter === 'LOCAL_OLLAMA') branch = 'ollama';\nelse if (adapter === 'TEST_HTTP_FAIL') branch = 'test_fail';\nelse if (adapter === 'MANUAL_OBSERVATION' || adapter === 'UI_OBSERVATION') branch = 'manual';\nreturn {\n  json: {\n    clientCode: job.clientCode,\n    jobId: job.jobId,\n    runKey: job.runKey,\n    engineId: job.engineId,\n    queryId: job.queryId,\n    adapter: adapter,\n    branch: branch\n  }\n};\n"
      },
      "id": "wf04-map-adapter",
      "name": "Map adapter to branch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
