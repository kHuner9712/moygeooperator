    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT q.query_text, q.language, q.region,\n       e.canonical_name,\n       COALESCE(e.aliases, '[]'::jsonb) AS aliases,\n       COALESCE((SELECT jsonb_agg(c.claim_text) FROM claims c\n                 WHERE c.entity_id = e.id AND c.verification = 'VERIFIED'),\n                '[]'::jsonb) AS verified_claims\nFROM queries q\nLEFT JOIN intents i ON i.id = q.intent_id\nLEFT JOIN entities e ON e.id = i.entity_id\nWHERE q.id = $1::uuid",
        "additionalFields": {
          "mode": "independently",
          "queryParams": "queryId"
        },
        "options": {}
      },
      "id": "wf04-context",
      "name": "Load observer context",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1540,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "QfC91xNjDOUTMtPB",
          "name": "geo-operator-postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Cold-probe prompt: the LLM answers the query naturally, WITHOUT being told to\n// mention the target, so we measure organic target visibility. The answer is raw\n// observation evidence — it never becomes a canonical business fact.\nconst ctx = $json;\nconst target = ctx.canonical_name || '';\nconst aliases = Array.isArray(ctx.aliases) ? ctx.aliases : [];\nconst targetNames = [target].concat(aliases).filter(Boolean);\nconst prompt =\n  'You are a neutral AI assistant. Answer the following query naturally and concisely, ' +\n  'the way a general search or chat assistant would. Do not mention any company or brand ' +\n  'unless it is genuinely relevant to the answer.\\n\\nQuery: ' + (ctx.query_text || '');\nreturn { json: { prompt: prompt, targetNames: targetNames, queryText: ctx.query_text || '' } };\n"
      },
      "id": "wf04-build-prompt",
      "name": "Build observer prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OLLAMA_URL || 'http://ollama:11434' }}/api/generate",
        "sendBody": true,
        "jsonBody": "={{ JSON.stringify({ model: ($env.OLLAMA_MODEL || 'qwen2.5:3b'), prompt: $json.prompt, stream: false, options: { temperature: 0 } }) }}",
        "specifyBody": "json",
        "options": {}
      },
      "id": "wf04-ollama",
      "name": "Call Ollama (local LLM observer)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract structured observation. Extraction is RULE-BASED (string-matching the\n// target aliases against the answer), NOT the LLM's self-report.\nconst raw = $json.response;\nlet answerText = '';\nif (typeof raw === 'string') {\n  try { const p = JSON.parse(raw); answerText = p.response || raw; } catch (e) { answerText = raw; }\n} else if (raw && raw.response) {\n  answerText = raw.response;\n}\nanswerText = String(answerText).trim();\nconst targetNames = $node['Build observer prompt'].json.targetNames || [];\nconst lower = answerText.toLowerCase();\nconst mentioned = targetNames.some(n => n && lower.indexOf(String(n).toLowerCase()) !== -1);\nconst recommendKw = ['推荐', '建议', '值得', 'recommend', 'best'];\nconst recommended = mentioned && recommendKw.some(k => lower.indexOf(k) !== -1);\nconst job = $node['Map adapter to branch'].json;\nreturn {\n  json: {\n    clientCode: job.clientCode,\n    engineId: job.engineId,\n    queryId: job.queryId,\n    observationKind: 'API_OBSERVATION',\n    observedAt: new Date().toISOString(),\n    runKey: job.runKey,\n    answerText: answerText,\n    targetMentioned: mentioned,\n    targetRecommended: recommended,\n    positionHint: null,\n    factualityStatus: '',\n    citations: '[]',\n    citedSurfaceIds: '[]',\n    evidenceUri: null,\n    rawArtifactRef: null,\n    latencyMs: ($json.total_duration ? Math.round($json.total_duration / 1000000) : null),\n    metadata: JSON.stringify({ observer: 'ollama', model: $json.model || 'qwen2.5' }), adapter: job.adapter\n  }\n};\n"
      },
      "id": "wf04-parse",
      "name": "Parse & extract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT record_observation(\n  $1, $2::uuid, $3::uuid,\n  $4::observation_kind, $5::timestamptz, $6,\n  $7, $8, $9, $10,\n  $11, $12::jsonb, $13::jsonb, $14,\n  $15, $16, NULL, $17::jsonb, $18\n) AS observation_id",
        "additionalFields": {
          "mode": "independently",
          "queryParams": "clientCode,engineId,queryId,observationKind,observedAt,runKey,answerText,targetMentioned,targetRecommended,positionHint,factualityStatus,citations,citedSurfaceIds,evidenceUri,rawArtifactRef,latencyMs,metadata,adapter"
        },
        "options": {}
      },
      "id": "wf04-record",
      "name": "Record observation",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
