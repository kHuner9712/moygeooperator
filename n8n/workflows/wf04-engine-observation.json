          },
          "conditions": [
            {
              "id": "wf04-cond-obs",
              "leftValue": "={{ $json.hasObservation }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "wf04-obs-if",
      "name": "Observation recorded?",
      "type": "n8n-nodes-base.if",
