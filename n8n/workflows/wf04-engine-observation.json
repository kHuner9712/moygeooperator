    {
      "parameters": {
        "jsCode": "// WF-04 entry. Emit ONLY the claimed job's runtime state. Graceful stop when\n// no job is claimed (emit ZERO items so the 'Has job?' IF passes nothing on).\nconst items = $input.all();\nif (items.length === 0) return [];\nconst j = items[0].json;\nif (!j || !j.job_id) return [];\nconst payload = (typeof j.payload_json === 'string' ? JSON.parse(j.payload_json) : j.payload_json) || {};\nconst engineId = payload.engine_id || null;\nconst queryId = payload.query_id || null;\nreturn [{\n  json: {\n    state: 'job',\n    hasJob: true,\n    clientCode: j.client_code,\n    jobId: j.job_id,\n    runKey: j.unique_key || ('obs:' + j.client_id + ':' + engineId + ':' + queryId),\n    engineId: engineId,\n    queryId: queryId\n  }\n}];\n"
      },
      "id": "wf04-observer",
      "name": "Select observer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "wf04-cond-job",
              "leftValue": "={{ $json.state }}",
              "rightValue": "job",
              "operator": {
