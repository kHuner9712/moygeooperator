        },
        "options": {}
      },
      "id": "wf04-resolve-adapter",
      "name": "Resolve engine adapter",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        880,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "QfC91xNjDOUTMtPB",
