    {
      "parameters": {
        "jsCode": "// P0.7 — the observation-check node only carries {hasObservation, observationId};\n// finish_job needs the jobId and the profile refresh needs engine_id. Re-attach\n// the job runtime context from the observer entry node.\nconst job = $node['Select observer'].json || {};\nconst out = Object.assign({}, $json || {});\nout.jobId = job.jobId;\nout.engineId = job.engineId;\nout.engine_id = job.engineId;\nreturn { json: out };\n"
      },
