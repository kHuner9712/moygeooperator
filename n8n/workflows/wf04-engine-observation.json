        }
      }
    },
    {
      "parameters": {
        "jsCode": "// P0.7 — no observation persisted: fail the job explicitly (never SUCCEED).\nconst job = $node['Select observer'].json;\nreturn { json: { jobId: job.jobId, error: 'UNSUPPORTED_ENGINE: observation not recorded' } };\n"
      },
      "id": "wf04-fail-obs",
      "name": "Fail job (no observation)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3080,
        240
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT fail_job($1::uuid, $2)",
        "additionalFields": {
          "mode": "independently",
          "queryParams": "jobId,error"
        },
        "options": {}
      },
      "id": "wf04-fail-db",
      "name": "Fail job in DB",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        3300,
        240
      ],
      "credentials": {
        "postgres": {
          "id": "QfC91xNjDOUTMtPB",
          "name": "geo-operator-postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// P0.6 — adapters that are not LOCAL_OLLAMA (NULL / MANUAL / UI / other API)\n// are NOT observed via Ollama. Derive the explicit terminal error.\nconst job = $node['Select observer'].json;\nconst branch = $node['Map adapter to branch'].json.branch || 'unsupported';\nconst error = branch === 'manual'\n  ? 'MANUAL_OBSERVATION_REQUIRED: no automated adapter; route to manual observation'\n  : 'UNSUPPORTED_ENGINE: no enabled automated adapter for engine; refusing to call Ollama';\nreturn { json: { jobId: job.jobId, error: error } };\n"
      },
      "id": "wf04-fail-adapter",
      "name": "Fail job (adapter)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "// No due job was claimed — end the run cleanly without erroring.\nreturn { json: { skipped: true } };\n"
      },
      "id": "wf04-noop",
      "name": "No-op (no job)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
