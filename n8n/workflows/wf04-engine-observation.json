      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "wf04-cond-ollama",
              "leftValue": "={{ $json.branch }}",
              "rightValue": "ollama",
              "operator": {
                "type": "string",
