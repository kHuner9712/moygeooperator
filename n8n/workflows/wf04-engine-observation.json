      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.code AS client_code, j.id AS job_id, j.client_id, j.unique_key, j.payload_json, j.priority\nFROM claim_next_job('wf04', 900, 'ENGINE_OBSERVATION') j\nLEFT JOIN clients c ON c.id = j.client_id\nWHERE j.id IS NOT NULL",
        "options": {}
