# ============================================================================
# MOY GEO Operator — Internal  · Stage 1 environment template
# Copy to .env and fill real values. Never commit .env.
# ============================================================================

# ---- PostgreSQL (System of Record) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=geo_operator
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=geo_operator

# Reused by postgres init to create per-service databases (kept on same server)
NOCODB_DB=nocodb
N8N_DB=n8n

# ---- NocoDB (internal ops UI) ----
# NocoDB's OWN metadata database (points to the same postgres server).
NOCODB_NC_DB_USER=geo_operator
NOCODB_NC_DB_PASSWORD=change-me-strong-password
NOCODB_NC_DB_HOST=postgres
NOCODB_NC_DB_PORT=5432
NOCODB_NC_DB_PUBLICPORT=5432
NOCODB_NC_DB_DATABASE=nocodb

# ---- n8n (workflow orchestration) ----
N8N_DB_TYPE=postgresdb
N8N_DB_USER=geo_operator
N8N_DB_PASSWORD=change-me-strong-password
N8N_DB_HOST=postgres
N8N_DB_PORT=5432
N8N_DB_DATABASE=n8n
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=operator
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
N8N_USER_FOLDER=/home/node/.n8n
# n8n requires a stable encryption key (>=32 chars). Generate with: openssl rand -base64 32
N8N_ENCRYPTION_KEY=change-me-32-char-min-encryption-key-x

# ---- Ollama (default local LLM: WF-01 extraction / WF-04 observer / WF-06 content) ----
# Model used by the WF-04 Local-LLM Observer; pull it first: docker compose exec ollama ollama pull qwen2.5
OLLAMA_MODEL=qwen2.5
OLLAMA_URLPORT=11434   # port the ollama process listens on inside the container
OLLAMA_PORTMAP=11434   # host port
OLLAMA_KEEP_ALIVE=5m

# ---- Exception queue notification (WF-08) ----
# When a REPORT run finds OPEN exceptions, WF-08 POSTs them to this webhook
# (e.g. a Lark/Feishu or generic inbound webhook) for manual intervention.
# EXCEPTION_NOTIFY_SECRET is the Feishu custom-bot signing secret (used for
# HMAC-SHA256 signature when the bot requires signature verification).
# Leave EXCEPTION_NOTIFY_URL empty to skip notification (best-effort).
EXCEPTION_NOTIFY_URL=
EXCEPTION_NOTIFY_SECRET=
# Allow $env access in node expressions (required for WF-08 Notify exceptions).
# Keep false in dev; harden in prod if you do not need $env in nodes.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# ---- Host ports (avoid collisions) ----
POSTGRES_PORTMAP=5432
NOCODB_PORTMAP=8080
N8N_PORTMAP=5678
# Stage 3 tooling (only started via `docker compose --profile tooling up`)
SEARXNG_PORTMAP=8888
CRAWL4AI_PORTMAP=11235
SEARXNG_SECRET=change-me-searxng-secret

# ---- Backup retention (daily/weekly copies kept) ----
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_DIR=/srv/geo-operator/backups